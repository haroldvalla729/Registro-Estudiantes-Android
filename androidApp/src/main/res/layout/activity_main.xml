<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:backgroundColor="#F8F9FA"
    android:padding="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- ENCABEZADO PRINCIPAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de Estudiantes"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete el formulario con sus datos académicos"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginBottom="28dp" />

        <!-- SECCIÓN 1: DATOS PERSONALES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre Completo"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. Juan Pérez"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:padding="14dp"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- SECCIÓN 2: SELECCIÓN DE CARRERA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccione su Carrera"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgCarrera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbTI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tecnologías de la Información"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/rbAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Administración de Empresas"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/rbContabilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contabilidad y Auditoría"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:minHeight="48dp" />
        </RadioGroup>

        <!-- SECCIÓN 3: MODALIDAD -->
        <CheckBox
            android:id="@+id/cbVirtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estudia en modalidad virtual"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:paddingStart="8dp"
            android:minHeight="48dp"
            android:layout_marginBottom="32dp" />

        <!-- BOTÓN PRINCIPAL -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTRAR ESTUDIANTE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D47A1"
            android:minHeight="54dp" />

    </LinearLayout>

</ScrollView>