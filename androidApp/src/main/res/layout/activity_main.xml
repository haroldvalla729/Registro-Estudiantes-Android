<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#202020"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo"
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre_estudiante"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#202020" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre"
            android:inputType="textPersonName|textCapWords"
            android:autofillHints="name"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seleccion_carrera"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#202020" />

        <RadioGroup
            android:id="@+id/rgCarreras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbTic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carrera_tic"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbAdministracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carrera_administracion"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbContabilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carrera_contabilidad"
                android:textSize="15sp" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modalidad_estudio"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#202020" />

        <CheckBox
            android:id="@+id/cbVirtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modalidad_virtual"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boton_registrar"
            android:minHeight="52dp" />

    </LinearLayout>

</ScrollView>
